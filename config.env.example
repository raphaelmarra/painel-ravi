# Copie para config.env (fica fora do Git) e preencha com os seus dados.
# Nunca coloque o PIN, tokens ou chaves de API aqui.

# S20: IP ou nome do aparelho na sua tailnet
S20_HOST=100.x.y.z
# Chave SSH que entra no chroot do S20 (só o caminho; a chave fica em ~/.ssh)
S20_SSH_KEY=~/.ssh/s20

# VPS opcional (painel em modo leitura e ações reversíveis). Deixe vazio se não tiver.
VPS_HOST=
VPS_SSH_KEY=

# Servidores que aparecem no seletor do painel (endereços do tailscale serve)
SERVIDORES_JSON='[{"nome":"S20","url":"https://s20.SUA-TAILNET.ts.net"}]'

# Arquivo local com o PIN do painel (fora do repositório)
PIN_ARQUIVO=~/.credentials/painel-pin.txt
