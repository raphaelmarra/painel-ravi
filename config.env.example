# Copie para config.env (fica fora do Git) e preencha com os seus dados.
# Nunca coloque o PIN, tokens ou chaves de API aqui.

# Servidor Linux com RAVI (VPS ou máquina em casa), acessível por SSH.
SERVIDOR_HOST=meu-servidor.exemplo
SERVIDOR_SSH_KEY=~/.ssh/meu-servidor
# Modo do painel nesse servidor:
#   vps      = só leitura e ações reversíveis (recomendado para servidor em produção)
#   completo = todas as ações, inclusive destrutivas
SERVIDOR_MODO=vps

# Android com RAVI (opcional, ver extras/android). Deixe vazio se não tiver.
ANDROID_HOST=
ANDROID_SSH_KEY=

# Servidores que aparecem no seletor do painel (endereços do tailscale serve)
SERVIDORES_JSON='[{"nome":"Servidor","url":"https://meu-servidor.SUA-TAILNET.ts.net"}]'

# Arquivo local com o PIN do painel (fora do repositório)
PIN_ARQUIVO=~/.credentials/painel-pin.txt
